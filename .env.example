# คัดลอกเป็น .env แล้วกรอกค่าจริง — .env อยู่ใน .gitignore ห้าม commit
# profile paper ไม่อ่านค่า API key เลย และไม่เรียก endpoint ที่ส่งคำสั่ง
CANE_BINANCE_API_KEY=
CANE_BINANCE_API_SECRET=

# DSN ของ PostgreSQL — ต้องเป็น postgresql+psycopg:// (psycopg 3) ไม่ใช่ psycopg2
# ค่านี้ตรงกับ docker-compose.yml ของ dev (พอร์ต 5436 ไม่ใช่ 5432)
#
# โค้ด **ไม่มีค่าตั้งต้น** ให้ตัวแปรนี้โดยเจตนา — DSN ที่ default ไปที่ localhost คือ
# ทางที่ prod ต่อผิดฐานแบบเงียบๆ ขาดตัวแปรต้องล้มดังตั้งแต่ตอนสร้าง Engine
#
# สั่งงานด้วย uv ให้ใส่ --env-file .env เพื่อให้ค่านี้ถึงโปรเซส เช่น
#   uv run --env-file .env alembic upgrade head
CANE_DB_DSN=postgresql+psycopg://cane:cane@localhost:5436/cane
