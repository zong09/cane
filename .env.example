# คัดลอกเป็น .env แล้วกรอกค่าจริง — .env อยู่ใน .gitignore ห้าม commit
# profile paper ไม่อ่านค่า API key เลย และไม่เรียก endpoint ที่ส่งคำสั่ง
CANE_BINANCE_API_KEY=
CANE_BINANCE_API_SECRET=

# DSN ของ PostgreSQL — ต้องเป็น postgresql+psycopg:// (psycopg 3) ไม่ใช่ psycopg2
# ค่านี้ตรงกับ docker-compose.yml ของ dev (พอร์ต 5436 ไม่ใช่ 5432)
#
# โค้ด **ไม่มีค่าตั้งต้น** ให้ตัวแปรนี้โดยเจตนา — DSN ที่ default ไปที่ localhost คือ
# ทางที่ prod ต่อผิดฐานแบบเงียบๆ ขาดตัวแปรต้องล้มดังตั้งแต่ตอนสร้าง Engine
#
# สั่งงานด้วย uv ให้ใส่ --env-file .env เพื่อให้ค่านี้ถึงโปรเซส เช่น
#   uv run --env-file .env alembic upgrade head
CANE_DB_DSN=postgresql+psycopg://cane:cane@localhost:5436/cane

# ── ผู้ตัดสิน confluence (LLM) ────────────────────────────────────────────────
# ปลายทางเป็น endpoint แบบ OpenAI-compatible เท่านั้น — vLLM / Ollama / LM Studio /
# OpenRouter / DashScope · **ทั้งสามค่านี้ไม่มีค่าตั้งต้น ขาดแล้วล้มตอนสร้าง client**
#
# ตัวอย่าง: http://localhost:11434/v1 (Ollama) · http://localhost:8000/v1 (vLLM)
#           https://dashscope-intl.aliyuncs.com/compatible-mode/v1 (Qwen)
# หมายเหตุ 2026-09-14: จากเน็ตองค์กรนี้ openrouter.ai และ dashscope.aliyuncs.com ถูก
# Zscaler ดัก TLS ฝั่ง Python — gateway ภายนอกต้องรอเครื่อง/เน็ตอื่น localhost ใช้ได้
CANE_LLM_BASE_URL=
# ชื่อโมเดลตามที่ gateway เรียก เช่น qwen3:32b หรือ qwen3.8-flash
CANE_LLM_MODEL=
# เว้นว่างได้เมื่อ gateway อยู่ที่ localhost และไม่ต้องใช้คีย์
CANE_LLM_API_KEY=

# ── คอนโซล: ผู้ใช้และ 2FA (ใบ 20) ────────────────────────────────────────────
# คีย์ที่ใช้เข้ารหัส TOTP secret ก่อนลง DB (ADR 25) — **ไม่มีค่าตั้งต้น** และ
# **หายไม่ได้** หายแล้ว 2FA ของทุกคนใช้ไม่ได้ ต้อง reset ทีละคน
# อย่างน้อย 32 อักษร · สร้างด้วย:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
CANE_SECRET_KEY=
